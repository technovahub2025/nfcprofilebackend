# Supply your existing MongoDB connection and a private JWT secret locally.
MONGO_URI=
JWT_SECRET=

# Create/restore a profile first. Paste its verified full HTML profile URL here.
# The destination must be served by this application using the current database.
# Leave empty to keep the original lookup behavior.
LEGACY_PROFILE_REDIRECT_URL=

# Use 302 while verifying. Set 301 once the destination is permanent.
LEGACY_PROFILE_REDIRECT_STATUS=302
